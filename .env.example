# PostgreSQL
DATABASE_URL="postgresql://usuario:password@localhost:5432/ecclesia?schema=public"

# Puerto del servidor (Railway lo inyecta automáticamente)
PORT=3000

# Origen(es) permitido(s) para CORS, separados por coma
CORS_ORIGIN="http://localhost:5173"

# OAuth de Google (mismo Client ID que usa el frontend con Google Identity Services)
GOOGLE_CLIENT_ID="tu-client-id.apps.googleusercontent.com"

# JWT propio emitido por este backend
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="7d"
